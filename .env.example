DATABASE_URL=postgresql://autopilot:autopilot@localhost:5432/autopilot
# Host port docker compose publishes Postgres on (change if 5432 is taken, and update DATABASE_URL)
AUTOPILOT_DB_PORT=5432
AUTOPILOT_LLM_PROVIDER=mock         # mock | anthropic | openai
WORKER_MODEL=claude-haiku-5-5       # cheap routine model
HARD_WORKER_MODEL=claude-sonnet-5-5
VERIFIER_MODEL=claude-sonnet-5-5    # MUST differ from the worker model used on a job
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_WORKER_MODEL=
OPENAI_VERIFIER_MODEL=
AUTOPILOT_ALLOW_MOCK_FALLBACK=false
TARGET_REPO_PATH=./demo_target
GITHUB_TOKEN=
GITHUB_REPO=
# docker | local | auto (auto = docker if available, else unsafe local fallback)
AUTOPILOT_SANDBOX=auto
