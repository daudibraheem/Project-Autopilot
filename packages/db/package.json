{
  "name": "@autopilot/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "prisma": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js",
    "generate": "pnpm prisma generate",
    "migrate:dev": "pnpm prisma migrate dev",
    "migrate:deploy": "pnpm prisma migrate deploy",
    "migrate:reset": "pnpm prisma migrate reset --force --skip-seed",
    "seed": "node --env-file-if-exists=../../.env --import tsx src/seed.ts",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "prisma": "6.19.3",
    "tsx": "4.23.15"
  }
}
